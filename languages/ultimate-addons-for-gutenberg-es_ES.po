#: spectra-v3/build/blocks/container/index.js:1
msgid "a generic container with no semantic meaning. Best for styling and layout purposes."
msgstr "un contenedor genérico sin significado semántico. Ideal para propósitos de estilo y diseño."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents introductory content, typically containing navigation aids and headings."
msgstr "representa contenido introductorio, que generalmente contiene ayudas de navegación y encabezados."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a footer for its nearest sectioning content, containing information about the author, copyright, or links."
msgstr "representa un pie de página para su contenido de sección más cercano, que contiene información sobre el autor, derechos de autor o enlaces."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents the dominant content of the page. There should be only one main element per page."
msgstr "representa el contenido dominante de la página. Debe haber solo un elemento principal por página."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a standalone piece of content that could be distributed independently, like a blog post or news article."
msgstr "representa una pieza de contenido independiente que podría distribuirse de manera autónoma, como una entrada de blog o un artículo de noticias."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a thematic grouping of content, typically with a heading. Use when no other semantic element is appropriate."
msgstr "representa un agrupamiento temático de contenido, generalmente con un encabezado. Úselo cuando no sea apropiado ningún otro elemento semántico."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents content that is tangentially related to the main content, like a sidebar or callout box."
msgstr "representa contenido que está tangencialmente relacionado con el contenido principal, como una barra lateral o un cuadro de llamada."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents self-contained content, like images, diagrams, or code snippets, often with a caption."
msgstr "representa contenido autónomo, como imágenes, diagramas o fragmentos de código, a menudo con un pie de foto."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a caption or legend describing the content of its parent figure element."
msgstr "representa un pie de foto o leyenda que describe el contenido de su elemento figura padre."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a summary, caption, or legend for a details element's disclosure box."
msgstr "representa un resumen, título o leyenda para el cuadro de divulgación de un elemento de detalles."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a section of navigation links to other pages or parts within the current page."
msgstr "representa una sección de enlaces de navegación a otras páginas o partes dentro de la página actual."

#: spectra-v3/build/blocks/container/index.js:1
msgid "creates a hyperlink to other pages, files, email addresses, or locations within the same page."
msgstr "crea un hipervínculo a otras páginas, archivos, direcciones de correo electrónico o ubicaciones dentro de la misma página."

#: spectra-v3/build/blocks/container/index.js:1
msgid "Flex Direction"
msgstr "Dirección de flexión"

#: spectra-v3/build/blocks/container/index.js:1
msgid "Orientation Reverse"
msgstr "Orientación inversa"

#: spectra-v3/build/blocks/container/index.js:1
msgid "When enabled, reverses the visual order of flex items. Use this to reverse the layout of containers within this block."
msgstr "Cuando está habilitado, invierte el orden visual de los elementos flexibles. Usa esto para invertir el diseño de los contenedores dentro de este bloque."

#: spectra-v3/build/blocks/container/index.js:1
msgid "Select the appropriate HTML element for semantic markup and accessibility."
msgstr "Selecciona el elemento HTML apropiado para el marcado semántico y la accesibilidad."

