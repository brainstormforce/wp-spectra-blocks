#: spectra-v3/build/blocks/container/index.js:1
msgid "a generic container with no semantic meaning. Best for styling and layout purposes."
msgstr "un conteneur générique sans signification sémantique. Idéal pour le style et la mise en page."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents introductory content, typically containing navigation aids and headings."
msgstr "représente un contenu introductif, contenant généralement des aides à la navigation et des titres."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a footer for its nearest sectioning content, containing information about the author, copyright, or links."
msgstr "représente un pied de page pour son contenu de sectionnement le plus proche, contenant des informations sur l'auteur, le droit d'auteur ou des liens."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents the dominant content of the page. There should be only one main element per page."
msgstr "représente le contenu principal de la page. Il ne devrait y avoir qu'un seul élément principal par page."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a standalone piece of content that could be distributed independently, like a blog post or news article."
msgstr "représente un contenu autonome qui pourrait être distribué indépendamment, comme un article de blog ou un article de presse."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a thematic grouping of content, typically with a heading. Use when no other semantic element is appropriate."
msgstr "représente un regroupement thématique de contenu, généralement avec un titre. À utiliser lorsqu'aucun autre élément sémantique n'est approprié."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents content that is tangentially related to the main content, like a sidebar or callout box."
msgstr "représente un contenu qui est tangentiellement lié au contenu principal, comme une barre latérale ou un encadré d'appel."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents self-contained content, like images, diagrams, or code snippets, often with a caption."
msgstr "représente un contenu autonome, comme des images, des diagrammes ou des extraits de code, souvent avec une légende."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a caption or legend describing the content of its parent figure element."
msgstr "représente une légende ou un sous-titre décrivant le contenu de son élément figure parent."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a summary, caption, or legend for a details element's disclosure box."
msgstr "représente un résumé, une légende ou une description pour la boîte de divulgation d'un élément de détails."

#: spectra-v3/build/blocks/container/index.js:1
msgid "represents a section of navigation links to other pages or parts within the current page."
msgstr "représente une section de liens de navigation vers d'autres pages ou parties au sein de la page actuelle."

#: spectra-v3/build/blocks/container/index.js:1
msgid "creates a hyperlink to other pages, files, email addresses, or locations within the same page."
msgstr "crée un lien hypertexte vers d'autres pages, fichiers, adresses e-mail ou emplacements au sein de la même page."

#: spectra-v3/build/blocks/container/index.js:1
msgid "Flex Direction"
msgstr "Direction de flexion"

#: spectra-v3/build/blocks/container/index.js:1
msgid "Orientation Reverse"
msgstr "Orientation inverse"

#: spectra-v3/build/blocks/container/index.js:1
msgid "When enabled, reverses the visual order of flex items. Use this to reverse the layout of containers within this block."
msgstr "Lorsqu'elle est activée, inverse l'ordre visuel des éléments flexibles. Utilisez ceci pour inverser la disposition des conteneurs dans ce bloc."

#: spectra-v3/build/blocks/container/index.js:1
msgid "Select the appropriate HTML element for semantic markup and accessibility."
msgstr "Sélectionnez l'élément HTML approprié pour le balisage sémantique et l'accessibilité."

