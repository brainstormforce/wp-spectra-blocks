<?xml version="1.0"?>
<ruleset name="Spectra Blocks">
    <description>PHPCS ruleset for the Spectra Blocks WordPress plugin.</description>

    <!-- Scan the plugin root -->
    <file>.</file>

    <!-- Exclude generated / third-party directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/lib/*</exclude-pattern>
    <exclude-pattern>*/blocks-config/*</exclude-pattern>

    <!-- Only check PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Show progress and use colours -->
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Use the full WordPress coding standard -->
    <rule ref="WordPress"/>

    <!-- Require PHP 8.1+ features / flag incompatible code -->
    <config name="testVersion" value="8.1-"/>

    <!-- Enforce the plugin's text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="spectra-blocks"/>
            </property>
        </properties>
    </rule>

    <!--
        The includes/ directory uses PSR-4 CamelCase class names (e.g. BlockUsageTracker)
        with WordPress-style file naming (class-block-usage-tracker.php).
        The WPCS InvalidClassFileName sniff derives the expected filename via str_replace('_','-')
        which produces class-blockusagetracker.php — incompatible with our CamelCase split naming.
        Exclude this one sniff for includes/ only; all other WPCS rules still apply.
    -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>*/includes/*</exclude-pattern>
    </rule>

    <!-- Enforce the plugin's global-variable / constant / function prefixes -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="spectra_blocks"/>
                <element value="SPECTRA_BLOCKS"/>
                <element value="Spectra"/>
            </property>
        </properties>
    </rule>

    <!--
        Block controller/view files (src/blocks/) are PHP partials included via a closure
        that exposes $attributes, $content, and $block. These are WordPress block API
        variables, not plugin-defined globals, so the prefix requirement does not apply.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
        <exclude-pattern>*/src/blocks/*</exclude-pattern>
    </rule>
</ruleset>