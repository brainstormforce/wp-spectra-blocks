<?xml version="1.0"?>
<ruleset name="Spectra Blocks">
    <description>PHPCS ruleset for the Spectra Blocks WordPress plugin.</description>

    <!-- Scan the plugin root -->
    <file>.</file>

    <!-- Exclude generated / third-party directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/lib/*</exclude-pattern>
    <exclude-pattern>*/blocks-config/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <!-- Only check PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Show progress and use colours -->
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Use the full WordPress coding standard -->
    <rule ref="WordPress"/>

    <!-- Require PHP 8.1+ features / flag incompatible code -->
    <config name="testVersion" value="8.1-"/>

    <!-- Enforce the plugin's text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="spectra-blocks"/>
            </property>
        </properties>
    </rule>

    <!--
        The includes/ directory uses PSR-4 CamelCase class names (e.g. BlockUsageTracker)
        with WordPress-style file naming (class-block-usage-tracker.php).
        The WPCS InvalidClassFileName sniff derives the expected filename via str_replace('_','-')
        which produces class-blockusagetracker.php — incompatible with our CamelCase split naming.
        Exclude this one sniff for includes/ only; all other WPCS rules still apply.
    -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>*/includes/*</exclude-pattern>
    </rule>

    <!-- Enforce the plugin's global-variable / constant / function prefixes -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="spectra_blocks"/>
                <element value="SPECTRA_BLOCKS"/>
                <element value="Spectra"/>
            </property>
        </properties>
    </rule>

    <!--
        Block controller/view files (src/blocks/) are PHP partials included via a closure
        that exposes $attributes, $content, and $block. These are WordPress block API
        variables, not plugin-defined globals, so the prefix requirement does not apply.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
        <exclude-pattern>*/src/blocks/*</exclude-pattern>
    </rule>

    <!--
        PHPUnit test classes follow PHPUnit's PascalCase convention (e.g. SanitizerTest.php
        for class SanitizerTest), which the WPCS hyphenated-lowercase file-name sniffs reject.
        Test files are not loaded by the plugin runtime; exclude file-name sniffs for tests/.
    -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!--
        The Style Guide / Global Styles colour engine works in the OKLCH colour space and
        uses its standard single-letter notation as variable names ($L = lightness,
        $C = chroma, $H = hue). Lower-casing these to satisfy snake_case would lose the
        domain meaning, so exclude the variable-name sniff for the colour-math directories only.
    -->
    <rule ref="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase">
        <exclude-pattern>*/includes/GlobalStyles/*</exclude-pattern>
        <exclude-pattern>*/includes/StyleGuide/*</exclude-pattern>
    </rule>

    <!--
        Relax a few production-oriented sniffs for the PHPUnit suite (tests/):
        - DocComment short descriptions are not expected on PHPUnit test methods.
        - GlobalVariablesOverride: tests legitimately set $post to build a render context.
        - NonEnqueuedScript: tests embed <script> strings as sanitizer input/assertions.
        - CommentedOutCode: test fixtures contain code-like example markup in comments.
    -->
    <rule ref="Generic.Commenting.DocComment">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.EnqueuedResources.NonEnqueuedScript">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.PHP.CommentedOutCode">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- Tests register simulated hooks and set globals to build fixtures; the plugin
         prefix requirement does not apply to that test scaffolding. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>